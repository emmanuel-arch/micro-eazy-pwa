# Micromart's entity in the core banking API. 3005 = MICROMART FINTECH, which is
# the entity the Connected Suite reads (SERVICESUITE_ENTITYID_MICROMART=3005).
# Was 3002 (Micromart Africa Limited) — a different entity, a different book.
VITE_ENTITY_ID=3005

# The id sent on the Repayment/STK call. A DIFFERENT ID SPACE — see
# PAYMENTS_ENTITY_ID in src/lib/micromart.js. Confirm with Micromart before
# changing; a wrong value here means the STK prompt never reaches the handset.
VITE_PAYMENTS_ENTITY_ID=7

VITE_LENDER_TAGLINE=Exceeding The Incredible
