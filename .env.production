# Production serves ONE Micromart book: Micromart Fintech. A customer who signs
# in successfully on Micromart Africa is told to call customer support instead.
#
#   3005 = MICROMART FINTECH     (served — its products route to workflow 1022)
#   3002 = MICROMART AFRICA LTD  (recognised at sign-in, referred to support)
VITE_ENTITY_IDS=3005
VITE_REFERRED_ENTITY_IDS=3002
VITE_SUPPORT_PHONE=0740961275

# New self-service registrations join the fintech book.
VITE_REGISTRATION_ENTITY_ID=3005
