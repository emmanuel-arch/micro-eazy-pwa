# Was VITE_ENTITY_ID=7 — an entity that does not exist. EntityCinfigurations
# answers 404 for it (verified 25 Aug 2026). It was harmless only because nothing
# read this variable; the app hard-coded 3002 in five files instead. Now that the
# code reads it, it has to be right.
VITE_ENTITY_ID=3005
VITE_PAYMENTS_ENTITY_ID=7

# Shown under the lender name on the sign-in screen. EntityCinfigurations does
# not carry a tagline; this keeps it configurable instead of hard-coded.
VITE_LENDER_TAGLINE=Exceeding The Incredible
