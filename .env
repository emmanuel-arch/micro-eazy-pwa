# The books this app serves. A customer is looked up across ALL of them at
# sign-in and the session is scoped to whichever one they are actually on —
# see src/lib/entity.js and src/lib/signin.js. There is no single "the entity"
# any more, because there never really was one.
#
#   3002 = MICROMART AFRICA LTD  (the SME / field book)
#   3005 = MICROMART FINTECH     (the app book — Micro Eazy products live here)
VITE_ENTITY_IDS=3002,3005

# Where a NEW self-service registration is created.
VITE_REGISTRATION_ENTITY_ID=3005

# Optional. The book whose branding shows on the splash and sign-in screens,
# before anyone has identified themselves. Defaults to the first of
# VITE_ENTITY_IDS; both Micromart books brand identically today.
# VITE_DEFAULT_ENTITY_ID=3002
